# KudiFlow Server Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@host/kudiflow?sslmode=require

# JWT Secrets — use strong random strings in production
JWT_SECRET=your-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3000
NODE_ENV=development

# OTP Configuration
# In development, OTP is logged to console. In production, integrate a real SMS provider.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# CORS
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081
